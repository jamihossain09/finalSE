@model IEnumerable<finalSE.Models.AssignmentTask>

@{
    ViewData["Title"] = "Assignment Management";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary me-3" style="border-radius: 8px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="fw-bold text-dark m-0"><i class="fas fa-tasks text-warning me-2"></i>Assignments</h2>
                <p class="text-muted m-0">Post class assignments, project tasks, and due date deadlines for students</p>
            </div>
        </div>
        <button class="btn btn-warning-premium text-white" type="button" data-bs-toggle="collapse" data-bs-target="#uploadCollapse">
            <i class="fas fa-plus me-2"></i>Post Assignment
        </button>
    </div>

    <!-- Alert notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Upload Form Collapse -->
    <div class="collapse mb-4" id="uploadCollapse">
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <h4 class="fw-bold m-0"><i class="fas fa-edit text-warning me-2"></i>Post New Assignment</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="PostAssignment" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assignment Title</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Lab Report 2: Newton's Laws" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Due Date & Time</label>
                            <input type="datetime-local" name="dueDate" class="form-control" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Instruction Attachment File (Optional)</label>
                            <input type="file" name="file" class="form-control" />
                            <div class="form-text">Attach helper worksheets, templates or detailed guidelines.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Assignment description / Details</label>
                            <textarea name="description" class="form-control" rows="4" placeholder="Enter assignment instructions, marks details, etc..." required></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                            <button type="button" class="btn btn-light" data-bs-toggle="collapse" data-bs-target="#uploadCollapse">Cancel</button>
                            <button type="submit" class="btn btn-warning text-white px-4" style="border-radius: 8px;">Publish Assignment</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Assignments List -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Description</th>
                            <th>Due Date</th>
                            <th>Attachment</th>
                            <th>Published At</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-file-signature fa-3x mb-3"></i>
                                    <p class="mb-0">No assignments posted yet.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var assignment in Model)
                            {
                                var isOverdue = assignment.DueDate < DateTime.Now;
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@assignment.Title</td>
                                    <td class="text-muted text-truncate" style="max-width: 250px;" title="@assignment.Description">
                                        @assignment.Description
                                    </td>
                                    <td>
                                        <span class="badge @(isOverdue ? "bg-danger-soft text-danger" : "bg-warning-soft text-warning") px-3 py-2 fw-semibold" style="border-radius: 8px;">
                                            <i class="far fa-clock me-1"></i> @assignment.DueDate.ToString("g")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(assignment.FilePath))
                                        {
                                            <a href="@assignment.FilePath" target="_blank" class="btn btn-link text-primary p-0 text-decoration-none">
                                                <i class="fas fa-paperclip me-1"></i> View File
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@assignment.CreatedAt.ToString("g")</td>
                                    <td class="text-end pe-4">
                                        <form asp-action="DeleteAssignment" method="post" onsubmit="return confirm('Are you sure you want to delete this assignment?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@assignment.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius: 8px;" title="Delete">
                                                <i class="fas fa-trash-can"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-danger-soft {
        background-color: rgba(220, 53, 69, 0.1);
    }
    .bg-warning-soft {
        background-color: rgba(255, 193, 7, 0.15);
    }
    .btn-warning-premium {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.6rem 1.2rem;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(255, 193, 7, 0.2);
        transition: all 0.2s;
    }
    .btn-warning-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(255, 193, 7, 0.35);
        color: white;
    }
</style>
