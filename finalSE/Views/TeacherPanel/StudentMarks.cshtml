@model IEnumerable<finalSE.Models.StudentMark>
@{
    ViewData["Title"] = "Student Marks Management";
    var teacher = ViewBag.Teacher as finalSE.Models.Teacher;
    var subjects = ViewBag.Subjects as List<finalSE.Models.Subject>;
    var selectedSubject = ViewBag.SelectedSubject as finalSE.Models.Subject;
}

<div class="container-fluid py-4 animate-up">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Student Marks &amp; Results</h1>
            <p class="text-muted mb-0">
                Department of <strong>@(teacher?.Department?.DepartmentName ?? "N/A")</strong>
                @if (selectedSubject != null)
                {
                    <span class="mx-2 text-muted">›</span>
                    <span class="text-primary fw-semibold">@selectedSubject.SubjectCode – @selectedSubject.SubjectName</span>
                }
            </p>
        </div>
        <div class="badge bg-primary px-3 py-2 fs-6 shadow-sm" style="border-radius: 8px;">
            <i class="fas fa-chalkboard-teacher me-2"></i> @teacher?.Name
        </div>
    </div>

    <!-- Alert Message Container -->
    <div id="alertContainer"></div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ============= STEP 1: Subject Picker ============= -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
            <h5 class="fw-bold m-0"><i class="fas fa-book-open text-primary me-2"></i>Select a Subject to Manage Marks</h5>
            <p class="text-muted small mt-1 mb-0">Click any subject card below to enter / update student marks for that subject.</p>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="row g-3">
                @if (subjects != null && subjects.Any())
                {
                    @foreach (var sub in subjects)
                    {
                        bool isActive = selectedSubject?.Id == sub.Id;
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <a href="@Url.Action("StudentMarks", "TeacherPanel", new { subjectId = sub.Id })"
                               class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 subject-card @(isActive ? "subject-card-active" : "")"
                                     style="border-radius: 16px; transition: all .25s;">
                                    <div class="card-body p-3 d-flex align-items-center gap-3">
                                        <div class="subject-icon-box @(isActive ? "bg-primary" : "bg-light")"
                                             style="width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i class="fas fa-book @(isActive ? "text-white" : "text-primary")"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size:.9rem;line-height:1.3;">@sub.SubjectName</div>
                                            <div class="text-muted" style="font-size:.78rem;">@sub.SubjectCode</div>
                                        </div>
                                        @if (isActive)
                                        {
                                            <div class="ms-auto">
                                                <i class="fas fa-check-circle text-primary"></i>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted py-4">
                        <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                        <p>No subjects found for your department. Please contact the administrator.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ============= STEP 2: Marks Table (only when subject selected) ============= -->
    @if (selectedSubject != null)
    {
        <!-- Grading Reference -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold m-0"><i class="fas fa-info-circle text-info me-2"></i>Grading System &amp; Distribution Reference</h5>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseGrading" aria-expanded="false">
                        Toggle Reference
                    </button>
                </div>
            </div>
            <div class="collapse" id="collapseGrading">
                <div class="card-body px-4 pb-4">
                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered text-center align-middle mb-0" style="font-size:.825rem;">
                                    <thead class="table-light">
                                        <tr><th>Marks Range</th><th>Letter Grade</th><th>Grade Point</th><th>Remarks</th></tr>
                                    </thead>
                                    <tbody>
                                        <tr class="table-success"><td>80–100</td><td><strong>A+</strong></td><td>4.00</td><td>Excellent</td></tr>
                                        <tr><td>75–79</td><td><strong>A</strong></td><td>3.75</td><td>Very Good</td></tr>
                                        <tr><td>70–74</td><td><strong>A−</strong></td><td>3.50</td><td>Very Good</td></tr>
                                        <tr><td>65–69</td><td><strong>B+</strong></td><td>3.25</td><td>Good</td></tr>
                                        <tr><td>60–64</td><td><strong>B</strong></td><td>3.00</td><td>Good</td></tr>
                                        <tr><td>55–59</td><td><strong>B−</strong></td><td>2.75</td><td>Satisfactory</td></tr>
                                        <tr><td>50–54</td><td><strong>C+</strong></td><td>2.50</td><td>Satisfactory</td></tr>
                                        <tr><td>45–49</td><td><strong>C</strong></td><td>2.25</td><td>Pass</td></tr>
                                        <tr><td>40–44</td><td><strong>D</strong></td><td>2.00</td><td>Pass</td></tr>
                                        <tr class="table-danger"><td>00–39</td><td><strong>F</strong></td><td>0.00</td><td>Fail</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-7 d-flex flex-column justify-content-center">
                            <div class="p-3 bg-light rounded-4">
                                <h6 class="fw-bold mb-2 text-dark"><i class="fas fa-chart-bar text-primary me-2"></i>Marks Distribution Rules</h6>
                                <ul class="mb-0 text-muted" style="font-size:.875rem;line-height:1.6;">
                                    <li><strong>Attendance Marks:</strong> Maximum weightage is <strong>10</strong> marks.</li>
                                    <li><strong>Class Test (CT) Marks:</strong> Maximum weightage is <strong>20</strong> marks.</li>
                                    <li><strong>Mid-term Marks:</strong> Maximum weightage is <strong>30</strong> marks.</li>
                                    <li><strong>Final Exam Marks:</strong> Maximum weightage is <strong>40</strong> marks.</li>
                                    <li><strong>Total Marks:</strong> Auto-calculated as the sum of all components (Max 100).</li>
                                    <li class="text-danger">Entering marks outside these ranges will result in validation errors.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Marks Entry Grid -->
        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="fw-bold m-0">
                    <i class="fas fa-edit text-success me-2"></i>
                    Marks Entry — <span class="text-primary">@selectedSubject.SubjectCode</span> @selectedSubject.SubjectName
                </h5>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("DownloadMarksTemplate", "TeacherPanel", new { subjectId = selectedSubject.Id })" class="btn btn-sm btn-outline-primary px-3" style="border-radius: 8px;">
                        <i class="fas fa-download me-1"></i> Download Template
                    </a>
                    <button type="button" class="btn btn-sm btn-success px-3" data-bs-toggle="modal" data-bs-target="#bulkUploadModal" style="border-radius: 8px;">
                        <i class="fas fa-file-excel me-1"></i> Bulk Upload (Excel/CSV)
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase fs-7 fw-bold text-muted border-bottom">
                            <tr>
                                <th class="ps-4">Student Name</th>
                                <th style="width:100px;">Attendance<br><span class="text-lowercase text-muted fw-normal">(Max 10)</span></th>
                                <th style="width:100px;">Class Test<br><span class="text-lowercase text-muted fw-normal">(Max 20)</span></th>
                                <th style="width:100px;">Mid-Term<br><span class="text-lowercase text-muted fw-normal">(Max 30)</span></th>
                                <th style="width:100px;">Final Exam<br><span class="text-lowercase text-muted fw-normal">(Max 40)</span></th>
                                <th style="width:80px;" class="text-center">Total</th>
                                <th style="width:120px;" class="text-center">Attendance Status</th>
                                <th style="width:80px;" class="text-center">Grade</th>
                                <th style="width:120px;" class="text-center">Status</th>
                                <th class="pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="fas fa-user-friends fa-3x mb-3 text-light"></i>
                                        <p class="mb-0 fs-5">No students found in your department.</p>
                                        <p class="small text-muted">Please contact the Administrator to enroll students.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr id="row-@item.StudentId" class="student-row">
                                        <td class="ps-4">
                                            <a href="javascript:void(0)"
                                               onclick="viewStudentDetails(@item.StudentId, @selectedSubject.Id)"
                                               class="fw-bold text-dark text-decoration-none student-name-link">
                                                @item.Student?.Name
                                            </a>
                                            <div class="text-muted small">@item.Student?.Email</div>
                                        </td>
                                        <td>
                                            <input type="number" step="any" min="0" max="10"
                                                   class="form-control form-control-sm marks-input text-center attendance-val"
                                                   value="@item.Attendance" data-student-id="@item.StudentId" />
                                        </td>
                                        <td>
                                            <input type="number" step="any" min="0" max="20"
                                                   class="form-control form-control-sm marks-input text-center ct-val"
                                                   value="@item.ClassTest" data-student-id="@item.StudentId" />
                                        </td>
                                        <td>
                                            <input type="number" step="any" min="0" max="30"
                                                   class="form-control form-control-sm marks-input text-center mid-val"
                                                   value="@item.MidTerm" data-student-id="@item.StudentId" />
                                        </td>
                                        <td>
                                            <input type="number" step="any" min="0" max="40"
                                                   class="form-control form-control-sm marks-input text-center final-val"
                                                   value="@item.FinalExam" data-student-id="@item.StudentId" />
                                        </td>
                                        <td class="text-center fw-bold total-text text-primary">
                                            @item.Total
                                        </td>
                                        <td class="text-center attendance-status-text">
                                            @if (item.AttendanceStatus == "Collegiate")
                                            {
                                                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 status-badge" style="border-radius:6px;">Collegiate</span>
                                            }
                                            else if (item.AttendanceStatus == "Non-Collegiate")
                                            {
                                                <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 status-badge" style="border-radius:6px;">Non-Collegiate</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 status-badge" style="border-radius:6px;">Dis-collegiate</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary grade-badge px-2.5 py-1.5 fs-7">@item.LetterGrade</span>
                                        </td>
                                        <td class="text-center status-container">
                                            @if (item.IsPublished)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2.5 py-1.5 status-badge" style="border-radius:6px;">
                                                    <i class="fas fa-check-circle me-1"></i> Published
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25 px-2.5 py-1.5 status-badge" style="border-radius:6px;">
                                                    <i class="fas fa-edit me-1"></i> Draft
                                                </span>
                                            }
                                        </td>
                                        <td class="pe-4 text-end">
                                            <div class="d-inline-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-primary save-btn"
                                                        onclick="saveMarks(@item.StudentId, @selectedSubject.Id)" title="Save changes">
                                                    <i class="fas fa-save"></i> Save
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm @(item.IsPublished ? "btn-outline-warning" : "btn-success") publish-btn"
                                                        onclick="togglePublish(@item.StudentId, @selectedSubject.Id, @(item.IsPublished ? "false" : "true"))">
                                                    @if (item.IsPublished)
                                                    {
                                                        <span><i class="fas fa-eye-slash me-1"></i> Draft</span>
                                                    }
                                                    else
                                                    {
                                                        <span><i class="fas fa-paper-plane me-1"></i> Publish</span>
                                                    }
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-info"
                                                        onclick="viewStudentDetails(@item.StudentId, @selectedSubject.Id)"
                                                        title="View Student Information">
                                                    <i class="fas fa-user"></i> Info
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Prompt when no subject selected -->
        <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 20px;">
            <div class="card-body">
                <div class="mx-auto mb-4" style="width:80px;height:80px;background:rgba(79,70,229,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-mouse-pointer fa-2x" style="color:#4f46e5;"></i>
                </div>
                <h4 class="fw-bold mb-2">Select a Subject Above</h4>
                <p class="text-muted mb-0">Choose a subject from the cards above to start entering or reviewing student marks.</p>
            </div>
        </div>
    }
</div>

<!-- Student Info Modal -->
<div class="modal fade" id="studentInfoModal" tabindex="-1" aria-labelledby="studentInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:24px;overflow:hidden;">
            <div class="modal-header text-white p-4" style="background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);">
                <h5 class="modal-title fw-bold" id="studentInfoModalLabel">
                    <i class="fas fa-id-card me-2"></i> Student Academic &amp; Personal Information
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm h-100 p-3" style="border-radius:16px;">
                            <div class="card-body text-center p-3">
                                <div class="mx-auto mb-3" style="width:80px;height:80px;background:rgba(79,70,229,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#4f46e5;">
                                    <i class="fas fa-user-graduate fa-3x"></i>
                                </div>
                                <h4 class="fw-bold text-dark mb-1" id="mStudentName">-</h4>
                                <span class="badge bg-secondary mb-3 px-3 py-1.5" id="mStudentDept">-</span>
                                <hr class="my-3 opacity-10">
                                <div class="text-start fs-7">
                                    <div class="mb-2 text-dark"><i class="fas fa-envelope text-muted me-2" style="width:20px;"></i><span id="mStudentEmail">-</span></div>
                                    <div class="mb-2 text-dark"><i class="fas fa-calendar-alt text-muted me-2" style="width:20px;"></i>Age: <span id="mStudentAge">-</span> years</div>
                                    <div class="text-dark"><i class="fas fa-map-marker-alt text-muted me-2" style="width:20px;"></i><span id="mStudentAddress">-</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="card border-0 shadow-sm h-100 p-3" style="border-radius:16px;">
                            <div class="card-body p-3">
                                <h5 class="fw-bold text-dark mb-1"><i class="fas fa-chart-line text-success me-2"></i>Academic Marksheet</h5>
                                <p class="text-muted small mb-3" id="mSubjectLabel">-</p>
                                <div class="table-responsive mb-3">
                                    <table class="table table-bordered table-sm align-middle text-center mb-0">
                                        <thead class="table-light">
                                            <tr><th>Assessment</th><th>Marks Obtained</th><th>Max Marks</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr><td class="text-start ps-3">Attendance</td><td class="fw-semibold" id="mAttendance">-</td><td class="text-muted">10</td></tr>
                                            <tr><td class="text-start ps-3">Class Test (CT)</td><td class="fw-semibold" id="mClassTest">-</td><td class="text-muted">20</td></tr>
                                            <tr><td class="text-start ps-3">Mid-term</td><td class="fw-semibold" id="mMidTerm">-</td><td class="text-muted">30</td></tr>
                                            <tr><td class="text-start ps-3">Final Exam</td><td class="fw-semibold" id="mFinalExam">-</td><td class="text-muted">40</td></tr>
                                            <tr class="table-primary fw-bold"><td class="text-start ps-3">Total Score</td><td id="mTotalScore">-</td><td>100</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="row g-2 text-center">
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3">
                                            <span class="text-muted small d-block">Letter Grade</span>
                                            <h4 class="fw-bold m-0 text-primary" id="mLetterGrade">-</h4>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3">
                                            <span class="text-muted small d-block">Grade Points</span>
                                            <h4 class="fw-bold m-0 text-success" id="mGradePoint">-</h4>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-2">
                                        <div class="p-2.5 rounded-3 d-flex justify-content-between align-items-center mb-2" id="mAttendanceStatusBlock" style="background:#f8fafc;">
                                            <span class="text-muted small"><i class="fas fa-user-check me-1 text-muted"></i>Collegiate Status:</span>
                                            <strong id="mAttendanceStatus" class="fs-7">-</strong>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="p-2.5 rounded-3 d-flex justify-content-between align-items-center" id="mStatusBlock">
                                            <span class="text-muted small"><i class="fas fa-info-circle me-1"></i>Remarks: <strong id="mRemarks">-</strong></span>
                                            <span id="mPublishBadge">-</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light px-4 pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius:10px;">Close</button>
            </div>
        </div>
    </div>
</div><!-- /#studentInfoModal -->

@if (selectedSubject != null)
{
    <!-- Bulk Upload Modal -->
    <div class="modal fade" id="bulkUploadModal" tabindex="-1" aria-labelledby="bulkUploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                @* NOTE: No form tag here — upload is handled via AJAX to prevent page freeze inside modal *@
                @Html.AntiForgeryToken()
                <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-top-left-radius: 20px; border-top-right-radius: 20px;">
                    <h5 class="modal-title fw-bold" id="bulkUploadModalLabel">
                        <i class="fas fa-file-excel me-2"></i> Bulk Marks Upload
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Inline feedback -->
                    <div id="bulkUploadAlert" class="d-none mb-3"></div>

                    <p class="text-muted small">
                        Import results in bulk for <strong>@selectedSubject.SubjectCode - @selectedSubject.SubjectName</strong>.
                    </p>
                    
                    <div class="alert alert-info border-0 rounded-3 mb-4" style="font-size: 0.85rem;">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Instructions:</strong>
                        <ol class="ps-3 mb-0 mt-1">
                            <li>Click <strong>Download Template</strong> to get the list of students in your department.</li>
                            <li>Open the CSV template in Excel, enter numerical marks under the score columns, and save the file.</li>
                            <li>Upload the updated CSV or Excel (.xlsx) file below.</li>
                            <li class="text-danger">Uploaded results will be verified and published automatically!</li>
                        </ol>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Spreadsheet File</label>
                        <input type="file" id="bulkUploadFileInput" class="form-control" accept=".csv, .xlsx, .xls" required />
                        <div class="form-text">Supports CSV, XLSX, and XLS formats.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light p-3" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
                    <button type="button" id="bulkUploadSubmitBtn" class="btn btn-success px-4" style="border-radius: 10px;"
                            onclick="submitBulkUpload(@selectedSubject.Id)">
                        <i class="fas fa-cloud-upload-alt me-1"></i> Upload &amp; Publish
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var currentSubjectId = @(selectedSubject?.Id.ToString() ?? "null");

        function getGradeBadgeClass(grade) {
            if (grade === "A+") return "bg-success";
            if (grade === "A" || grade === "A-") return "bg-success-subtle text-success border border-success border-opacity-25";
            if (grade.startsWith("B")) return "bg-primary-subtle text-primary border border-primary border-opacity-25";
            if (grade.startsWith("C")) return "bg-info-subtle text-info border border-info border-opacity-25";
            if (grade === "D") return "bg-warning-subtle text-warning border border-warning border-opacity-25";
            return "bg-danger text-white";
        }

        $(document).ready(function () {
            $('.grade-badge').each(function () {
                var grade = $(this).text().trim();
                $(this).removeClass('bg-secondary').addClass(getGradeBadgeClass(grade));
            });

            // Move modals to body to prevent z-index freeze due to animate-up parent wrapper
            var infoModal = document.getElementById('studentInfoModal');
            if (infoModal) document.body.appendChild(infoModal);

            var bulkModal = document.getElementById('bulkUploadModal');
            if (bulkModal) document.body.appendChild(bulkModal);
        });

        function updateGradeBadgeColor(rowId, grade) {
            var badge = $('#row-' + rowId + ' .grade-badge');
            badge.removeClass(function (index, className) {
                return (className.match(/(^|\s)bg-\S+/g) || []).join(' ');
            }).removeClass('text-success text-primary text-info text-warning border border-success border-primary border-info border-warning border-opacity-25');
            badge.addClass('grade-badge px-2.5 py-1.5 fs-7').addClass(getGradeBadgeClass(grade)).text(grade);
        }

        function showAlert(type, message) {
            var icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
            var alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 border-0" role="alert" style="border-radius:12px;">
                    <i class="fas ${icon} fs-5"></i>
                    <div>${message}</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            $('#alertContainer').html(alertHtml);
            setTimeout(function () { $('.alert').alert('close'); }, 4000);
        }

        function saveMarks(studentId, subjectId) {
            var row = $('#row-' + studentId);
            var attendance = parseFloat(row.find('.attendance-val').val()) || 0;
            var classTest  = parseFloat(row.find('.ct-val').val()) || 0;
            var midTerm    = parseFloat(row.find('.mid-val').val()) || 0;
            var finalExam  = parseFloat(row.find('.final-val').val()) || 0;

            if (attendance < 0 || attendance > 10) { showAlert('danger', 'Attendance marks must be between 0 and 10.'); return; }
            if (classTest  < 0 || classTest  > 20) { showAlert('danger', 'Class Test marks must be between 0 and 20.'); return; }
            if (midTerm    < 0 || midTerm    > 30) { showAlert('danger', 'Mid-Term marks must be between 0 and 30.'); return; }
            if (finalExam  < 0 || finalExam  > 40) { showAlert('danger', 'Final Exam marks must be between 0 and 40.'); return; }

            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '@Url.Action("UpdateMarks", "TeacherPanel")',
                type: 'POST',
                data: { __RequestVerificationToken: token, studentId, subjectId, attendance, classTest, midTerm, finalExam },
                success: function (response) {
                    if (response.success) {
                        row.find('.total-text').text(response.total.toFixed(1));
                        updateGradeBadgeColor(studentId, response.letterGrade);
                        
                        var statusBadge = '';
                        if (response.attendanceStatus === 'Collegiate') {
                            statusBadge = '<span class="badge bg-success-subtle text-success px-2.5 py-1.5 status-badge" style="border-radius:6px;">Collegiate</span>';
                        } else if (response.attendanceStatus === 'Non-Collegiate') {
                            statusBadge = '<span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 status-badge" style="border-radius:6px;">Non-Collegiate</span>';
                        } else {
                            statusBadge = '<span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 status-badge" style="border-radius:6px;">Dis-collegiate</span>';
                        }
                        row.find('.attendance-status-text').html(statusBadge);

                        showAlert('success', 'Marks for ' + row.find('.student-name-link').text().trim() + ' saved successfully!');
                    } else {
                        showAlert('danger', response.message);
                    }
                },
                error: function () { showAlert('danger', 'An unexpected error occurred while saving marks.'); }
            });
        }

        function togglePublish(studentId, subjectId, publish) {
            var row   = $('#row-' + studentId);
            var token = $('input[name="__RequestVerificationToken"]').val();
            var name  = row.find('.student-name-link').text().trim();

            $.ajax({
                url: '@Url.Action("PublishResult", "TeacherPanel")',
                type: 'POST',
                data: { __RequestVerificationToken: token, studentId, subjectId, publish },
                success: function (response) {
                    if (response.success) {
                        var statusContainer = row.find('.status-container');
                        var publishBtn      = row.find('.publish-btn');
                        if (response.isPublished) {
                            statusContainer.html(`<span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2.5 py-1.5 status-badge" style="border-radius:6px;"><i class="fas fa-check-circle me-1"></i> Published</span>`);
                            publishBtn.removeClass('btn-success').addClass('btn-outline-warning')
                                      .html('<span><i class="fas fa-eye-slash me-1"></i> Draft</span>')
                                      .attr('onclick', `togglePublish(${studentId}, ${subjectId}, false)`);
                            showAlert('success', 'Published results for ' + name);
                        } else {
                            statusContainer.html(`<span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25 px-2.5 py-1.5 status-badge" style="border-radius:6px;"><i class="fas fa-edit me-1"></i> Draft</span>`);
                            publishBtn.removeClass('btn-outline-warning').addClass('btn-success')
                                      .html('<span><i class="fas fa-paper-plane me-1"></i> Publish</span>')
                                      .attr('onclick', `togglePublish(${studentId}, ${subjectId}, true)`);
                            showAlert('success', 'Reverted results to draft for ' + name);
                        }
                    } else {
                        showAlert('danger', response.message);
                    }
                },
                error: function () { showAlert('danger', 'An unexpected error occurred while toggling publish state.'); }
            });
        }

        function viewStudentDetails(studentId, subjectId) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('@Url.Action("GetStudentInfo", "TeacherPanel")?studentId=' + studentId + '&subjectId=' + subjectId, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(function(response) {
                    if (response.success) {
                        document.getElementById('mStudentName').textContent = response.student.name;
                        document.getElementById('mStudentDept').textContent = response.student.department;
                        document.getElementById('mStudentEmail').textContent = response.student.email;
                        document.getElementById('mStudentAge').textContent = response.student.age;
                        document.getElementById('mStudentAddress').textContent = response.student.address || 'N/A';

                        if (response.marks) {
                            document.getElementById('mAttendance').textContent = response.marks.attendance.toFixed(1);
                            document.getElementById('mClassTest').textContent = response.marks.classTest.toFixed(1);
                            document.getElementById('mMidTerm').textContent = response.marks.midTerm.toFixed(1);
                            document.getElementById('mFinalExam').textContent = response.marks.finalExam.toFixed(1);
                            document.getElementById('mTotalScore').textContent = response.marks.total.toFixed(1);
                            document.getElementById('mLetterGrade').textContent = response.marks.letterGrade;
                            document.getElementById('mGradePoint').textContent = response.marks.gradePoint;
                            document.getElementById('mRemarks').textContent = response.marks.remarks;

                            var attStatus = response.marks.attendanceStatus;
                            var attEl = document.getElementById('mAttendanceStatus');
                            attEl.textContent = attStatus;
                            attEl.className = attStatus === 'Collegiate' ? 'text-success fw-bold'
                                            : attStatus === 'Non-Collegiate' ? 'text-warning fw-bold'
                                            : 'text-danger fw-bold';

                            var badgeHtml = '';
                            var statusBlock = document.getElementById('mStatusBlock');
                            if (response.marks.isPublished) {
                                badgeHtml = '<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Published</span>';
                                statusBlock.className = 'p-2.5 rounded-3 d-flex justify-content-between align-items-center bg-success-subtle text-success';
                            } else {
                                badgeHtml = '<span class="badge bg-warning text-dark"><i class="fas fa-edit me-1"></i> Draft</span>';
                                statusBlock.className = 'p-2.5 rounded-3 d-flex justify-content-between align-items-center bg-warning-subtle text-warning';
                            }
                            document.getElementById('mPublishBadge').innerHTML = badgeHtml;
                        } else {
                            ['mAttendance','mClassTest','mMidTerm','mFinalExam','mTotalScore','mLetterGrade','mGradePoint','mRemarks','mAttendanceStatus'].forEach(function(id){
                                document.getElementById(id).textContent = 'N/A';
                            });
                            document.getElementById('mPublishBadge').innerHTML = '<span class="badge bg-secondary">No record</span>';
                            document.getElementById('mStatusBlock').className = 'p-2.5 rounded-3 d-flex justify-content-between align-items-center bg-secondary-subtle';
                        }

                        // Use getOrCreateInstance to avoid duplicate modal / freeze
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('studentInfoModal')).show();
                    } else {
                        alert(response.message);
                    }
            })
            .catch(function() { alert('Could not retrieve student information.'); });
        }

        // ===== AJAX Bulk Upload — prevents page freeze inside Bootstrap modal =====
        function submitBulkUpload(subjectId) {
            var fileInput = document.getElementById('bulkUploadFileInput');
            var alertBox  = document.getElementById('bulkUploadAlert');
            var submitBtn = document.getElementById('bulkUploadSubmitBtn');

            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                alertBox.className = 'alert alert-warning mb-3';
                alertBox.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Please select a file before uploading.';
                return;
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('subjectId', subjectId);
            formData.append('__RequestVerificationToken', token);

            // Show spinner
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Uploading...';
            alertBox.className = 'd-none mb-3';

            fetch('@Url.Action("UploadMarksExcel", "TeacherPanel")', {
                method: 'POST',
                // NOTE: Do NOT set Content-Type — browser sets it automatically with correct boundary for FormData
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(function(response) {
                // Always read as text first so we can handle both JSON and HTML redirect responses
                return response.text().then(function(text) {
                    return { ok: response.ok, status: response.status, text: text };
                });
            })
            .then(function(result) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-cloud-upload-alt me-1"></i> Upload & Publish';

                var data = null;
                try { data = JSON.parse(result.text); } catch(e) { /* not JSON — might be redirect HTML */ }

                if (data && data.success === false) {
                    alertBox.className = 'alert alert-danger mb-3';
                    alertBox.innerHTML = '<i class="fas fa-times-circle me-2"></i>' + (data.message || 'Upload failed.');
                } else if (data && data.success === true) {
                    alertBox.className = 'alert alert-success mb-3';
                    alertBox.innerHTML = '<i class="fas fa-check-circle me-2"></i>' + (data.message || 'File uploaded successfully! Refreshing marks...');
                    setTimeout(function () { window.location.reload(); }, 1800);
                } else {
                    // Non-JSON response (redirect page), treat as success
                    alertBox.className = 'alert alert-success mb-3';
                    alertBox.innerHTML = '<i class="fas fa-check-circle me-2"></i>Marks uploaded and published successfully! Refreshing...';
                    setTimeout(function () { window.location.reload(); }, 1800);
                }
            })
            .catch(function(err) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-cloud-upload-alt me-1"></i> Upload & Publish';
                alertBox.className = 'alert alert-danger mb-3';
                alertBox.innerHTML = '<i class="fas fa-times-circle me-2"></i>Network error during upload. Please try again.';
            });
        }
    </script>
}

