@model IEnumerable<finalSE.Models.Invitation>

@{
    ViewData["Title"] = "Invitations Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2" role="alert" style="border-radius: 1rem;">
        <i class="fas fa-check-circle fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2" role="alert" style="border-radius: 1rem;">
        <i class="fas fa-exclamation-circle fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="premium-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold m-0" style="letter-spacing: -0.02em;">Invitations List</h3>
            <p class="text-muted m-0 small">Manage and track sent register invitations</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-premium py-2 px-4 d-flex align-items-center gap-2">
            <i class="fas fa-plus"></i> Send New Invitation
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr class="table-light">
                    <th class="border-0" style="border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem;">Email</th>
                    <th class="border-0">Role</th>
                    <th class="border-0">Department</th>
                    <th class="border-0">Status</th>
                    <th class="border-0">Expires</th>
                    <th class="border-0" style="border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Email</td>
                        <td>
                            <span class="badge bg-opacity-10 bg-indigo text-indigo fs-7" style="background-color: rgba(79, 70, 229, 0.1); color: var(--primary);">
                                @(item.Role?.RoleName ?? item.RoleId.ToString())
                            </span>
                        </td>
                        <td>
                            @if (item.Department != null)
                            {
                                <span class="text-dark"><i class="fas fa-building me-1 text-muted"></i>@item.Department.DepartmentName</span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            @if (item.IsUsed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                    <i class="fas fa-check me-1"></i> Used
                                </span>
                            }
                            else if (item.ExpireDate < DateTime.Now)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                    <i class="fas fa-clock me-1"></i> Expired
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                    <i class="fas fa-spinner fa-spin me-1"></i> Pending
                                </span>
                            }
                        </td>
                        <td class="text-muted small">@item.ExpireDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (!item.IsUsed)
                            {
                                var registrationLink = $"{Context.Request.Scheme}://{Context.Request.Host}/Account/RegisterWithToken?token={item.Token}";
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary" style="border-radius: 0.5rem;" onclick="navigator.clipboard.writeText('@registrationLink'); alert('Registration link copied!');">
                                        <i class="fas fa-copy me-1"></i> Copy Link
                                    </button>
                                    <button class="btn btn-sm btn-light" style="border-radius: 0.5rem;" type="button" data-bs-toggle="collapse" data-bs-target="#emailForm-@item.Id">
                                        <i class="fas fa-envelope"></i> Resend Email
                                    </button>
                                </div>
                                <div class="collapse mt-2" id="emailForm-@item.Id" style="max-width: 300px;">
                                    <form asp-action="ResendEmail" method="post" class="input-group input-group-sm">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="token" value="@item.Token" />
                                        <input type="email" name="email" value="@item.Email" class="form-control" placeholder="Recipient email" required />
                                        <button class="btn btn-primary" type="submit">
                                            <i class="fas fa-paper-plane"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-success"><i class="fas fa-check-double me-1"></i> Joined System</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>