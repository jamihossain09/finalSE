@model IEnumerable<finalSE.Models.Subject>
@{
    ViewData["Title"] = "Course Assignments";
    var assignments = ViewBag.Assignments as Dictionary<int, finalSE.Models.CourseAssignment>;
    var teachers = ViewBag.Teachers as List<finalSE.Models.Teacher>;
}

<!-- PREMIUM HEADER -->
<div class="row mb-4 animate-up">
    <div class="col-12">
        <div class="p-4 text-white rounded-4 shadow-sm position-relative overflow-hidden" 
             style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold m-0"><i class="fas fa-book-reader me-2 text-indigo-400"></i> Course & Teacher Assignment</h2>
                    <p class="m-0 mt-1 text-muted-light small">Map faculty members to specific academic subjects.</p>
                </div>
                <a href="@Url.Action("AdminDashboard", "Home")" class="btn btn-outline-light btn-sm rounded-pill px-3">
                    <i class="fas fa-arrow-left me-1"></i> Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ALERTS -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- MAIN CONTENT -->
<div class="row g-4 animate-up">
    <div class="col-12">
        <div class="premium-card p-4 shadow-sm bg-white rounded-4">
            <h5 class="fw-bold mb-4"><i class="fas fa-tasks text-primary me-2"></i> Subject Mapping List</h5>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th scope="col" style="width: 15%;">Subject Code</th>
                            <th scope="col" style="width: 30%;">Subject Name</th>
                            <th scope="col" style="width: 20%;">Department</th>
                            <th scope="col" style="width: 35%;">Assigned Teacher</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model)
                        {
                            var hasAssignment = assignments != null && assignments.ContainsKey(subject.Id);
                            var assignedTeacherId = hasAssignment ? assignments[subject.Id].TeacherId : 0;
                            var deptTeachers = teachers?.Where(t => t.DepartmentId == subject.DepartmentId).ToList() ?? new List<finalSE.Models.Teacher>();

                            <tr>
                                <td>
                                    <span class="badge bg-indigo-soft text-indigo-bold rounded-pill px-3 py-2 fw-semibold">
                                        @subject.SubjectCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@subject.SubjectName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="fas fa-building me-1 opacity-50"></i> @subject.Department?.DepartmentName
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="Assign" method="post" class="d-flex align-items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="subjectId" value="@subject.Id" />
                                        
                                        <select name="teacherId" class="form-select form-select-sm rounded-3 shadow-sm" style="max-width: 250px;">
                                            <option value="">-- Unassigned --</option>
                                            @foreach (var teacher in deptTeachers)
                                            {
                                                <option value="@teacher.Id" selected="@(teacher.Id == assignedTeacherId ? "selected" : null)">
                                                    @teacher.Name
                                                </option>
                                            }
                                        </select>
                                        
                                        <button type="submit" class="btn btn-primary btn-sm rounded-3 px-3 shadow-sm d-flex align-items-center gap-1">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-indigo-soft {
        background-color: #e0e7ff;
    }
    .text-indigo-bold {
        color: #4338ca;
    }
    .text-muted-light {
        color: #cbd5e1;
    }
</style>
