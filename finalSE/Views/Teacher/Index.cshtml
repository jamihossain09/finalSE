@model IEnumerable<Teacher>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h2>Teacher List</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- TABLE GRID -->
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Department?.DepartmentName</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete @Html.Raw(item.Name.Replace("'", "\\'"))? This will also remove all their class records, marks, assignments, and payment history.');">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    <div class="mt-3">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-action="Index"
                   asp-route-page="@i"
                   class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-primary")">
                @i
            </a>
        }
    </div>

</div>