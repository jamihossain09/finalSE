@model finalSE.Models.Teacher

@{
    ViewData["Title"] = "Edit Teacher Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="premium-card animate-up p-4">
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div style="width:48px;height:48px;background:rgba(79,70,229,.1);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#4f46e5;">
                            <i class="fas fa-user-edit fs-5"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold m-0">Edit Teacher Profile</h3>
                            <p class="text-muted small m-0">Update teacher name, contact, and department</p>
                        </div>
                    </div>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 rounded-3 mb-4">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label class="form-label fw-semibold" asp-for="Name">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-id-card text-muted"></i>
                            </span>
                            <input asp-for="Name" class="form-control border-start-0"
                                   placeholder="Teacher's full name" required style="height:3rem;" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-semibold" asp-for="Email">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-envelope text-muted"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0"
                                   placeholder="Teacher's email" required style="height:3rem;" />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-semibold" asp-for="Phone">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-phone text-muted"></i>
                            </span>
                            <input asp-for="Phone" class="form-control border-start-0"
                                   placeholder="Phone number" style="height:3rem;" />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-semibold" asp-for="Address">Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-map-marker-alt text-muted"></i>
                            </span>
                            <input asp-for="Address" class="form-control border-start-0"
                                   placeholder="Address" style="height:3rem;" />
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold" asp-for="DepartmentId">Department</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-building text-muted"></i>
                            </span>
                            <select asp-for="DepartmentId" asp-items="ViewBag.Departments"
                                    class="form-control border-start-0" required style="height:3rem;">
                                <option value="">-- Select Department --</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn-primary-premium flex-grow-1 justify-content-center">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4" style="border-radius:12px;">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
