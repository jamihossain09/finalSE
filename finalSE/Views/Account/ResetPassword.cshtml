@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5">
        <div class="premium-card animate-up">
            <div class="text-center mb-4">
                <div class="inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: inline-flex;">
                    <i class="fas fa-lock text-success" style="font-size: 1.75rem;"></i>
                </div>
                <h3 class="fw-bold">Reset Your Password</h3>
                <p class="text-muted">Set a strong, new password for your account: <strong>@ViewBag.Email</strong></p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="email" value="@ViewBag.Email" />

                <div class="form-group mb-3">
                    <label class="form-label fw-semibold" for="password">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-lock text-muted"></i>
                        </span>
                        <input type="password" id="password" name="password" class="form-control border-start-0" placeholder="••••••••" required style="height: 3rem;" />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-semibold" for="confirmPassword">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-lock text-muted"></i>
                        </span>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control border-start-0" placeholder="••••••••" required style="height: 3rem;" />
                    </div>
                </div>

                <button type="submit" class="btn-primary-premium w-100 justify-content-center">
                    Reset Password <i class="fas fa-check-circle ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</div>
