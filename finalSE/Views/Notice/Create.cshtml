@model finalSE.Models.Notice

@{
    ViewData["Title"] = "Publish Notice";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h3 class="fw-bold m-0"><i class="fas fa-bullhorn text-primary me-2"></i>Publish New Notice</h3>
                    <p class="text-muted mb-0">Fill out details and upload a PDF notice file</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Notice Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Summer Vacation Announcement" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Summary</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter a short description or summary..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Upload PDF Document</label>
                            <input type="file" name="pdfFile" class="form-control" accept=".pdf" required />
                            <span asp-validation-for="FilePath" class="text-danger"></span>
                            <div class="form-text">Only PDF format is allowed. Max size 10MB.</div>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-2 border-top">
                            <a asp-action="Index" class="btn btn-light px-4 me-md-2" style="border-radius: 8px;">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4" style="border-radius: 8px;">Publish</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
