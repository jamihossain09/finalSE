@model finalSE.Models.Notice

@{
    ViewData["Title"] = "Publish Academic Notice";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="premium-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div style="width: 50px; height: 50px; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); border-radius: 14px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.25rem;">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold m-0" style="letter-spacing: -0.02em;">Publish Notice</h3>
                        <p class="text-muted m-0 small">Create system-wide or department-specific notice</p>
                    </div>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-secondary">Notice Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Class Rescheduled Announcement" required style="border-radius: 0.75rem; height: 3rem;" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold text-secondary">Description / Summary</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter notice brief summary..." style="border-radius: 0.75rem;"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Academic Department</label>
                        <select name="departmentId" class="form-select" style="border-radius: 0.75rem; height: 3rem;">
                            <option value="">System-Wide (All Departments)</option>
                            @if (ViewBag.Departments != null)
                            {
                                @foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.Id">@dept.DepartmentName</option>
                                }
                            }
                        </select>
                        <div class="form-text text-muted small">Select a department if you want only teachers/students of that department to see this notice.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary">PDF Document</label>
                        <input type="file" name="pdfFile" class="form-control" accept=".pdf" required style="border-radius: 0.75rem;" />
                        <span asp-validation-for="FilePath" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-secondary-premium flex-fill py-2" style="border-radius: 0.75rem;">Cancel</a>
                        <button type="submit" class="btn btn-primary-premium flex-fill py-2 justify-content-center">Publish</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
