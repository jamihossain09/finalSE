@model IEnumerable<finalSE.Models.Notice>

@{
    ViewData["Title"] = "School Notice Board";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="fas fa-bullhorn text-primary me-2"></i>Notice Board</h2>
            <p class="text-muted m-0">View latest announcements and official updates</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-premium">
                <i class="fas fa-plus me-2"></i>Publish Notice
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted">
                    <i class="far fa-clipboard fa-3x mb-3"></i>
                    <p class="fs-5">No notices published yet.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var notice in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 16px; overflow: hidden; background: #fff; transition: transform 0.2s;">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-light text-primary py-2 px-3 fw-bold" style="border-radius: 8px;">
                                    <i class="far fa-calendar-alt me-1"></i> @notice.PublishedAt.ToString("MMM dd, yyyy")
                                </span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this notice?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notice.Id" />
                                        <button type="submit" class="btn btn-link text-danger p-0 border-0" title="Delete Notice">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                            <h4 class="card-title fw-bold text-dark mb-2">@notice.Title</h4>
                            <p class="card-text text-muted flex-grow-1">@notice.Description</p>
                            
                            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small"><i class="far fa-file-pdf text-danger me-1"></i> PDF Document</span>
                                <div class="d-flex gap-2">
                                    <a href="@notice.FilePath" target="_blank" class="btn btn-outline-primary btn-sm px-3" style="border-radius: 8px;">
                                        <i class="far fa-eye me-1"></i> View
                                    </a>
                                    <a href="@notice.FilePath" download class="btn btn-primary btn-sm px-3" style="border-radius: 8px;">
                                        <i class="fas fa-download me-1"></i> Download
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
