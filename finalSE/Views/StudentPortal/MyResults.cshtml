@model IEnumerable<finalSE.Models.StudentMark>
@{
    ViewData["Title"] = "My Academic Results";
    var student = ViewBag.Student as finalSE.Models.StudentModel;
}

<div class="container-fluid py-4 animate-up">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 text-white rounded-5 shadow-lg position-relative overflow-hidden" 
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 24px;">
                <div class="position-relative z-index-1">
                    <span class="badge bg-white bg-opacity-20 text-white px-3 py-2 fs-7 fw-semibold mb-3" style="border-radius: 8px;">
                        <i class="fas fa-graduation-cap me-1"></i> Student Academic Record
                    </span>
                    <h1 class="fw-bold display-5 mb-2">Academic Transcript</h1>
                    <p class="fs-5 text-white-50 mb-0">Student: <strong>@student?.Name</strong> &bull; Department of @(student?.Department?.DepartmentName ?? "N/A") &bull; @student?.Email</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Results Section -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-5 text-center" style="border-radius: 20px;">
                    <div class="py-5">
                        <div class="mx-auto mb-4" style="width: 100px; height: 100px; background: rgba(79, 70, 229, 0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #4f46e5;">
                            <i class="fas fa-clipboard-list fa-4x text-muted opacity-50"></i>
                        </div>
                        <h3 class="fw-bold mb-2">No Grade Records Found</h3>
                        <p class="text-muted mb-0">There are no grading records registered for you yet.</p>
                        <p class="small text-muted">Once your class teachers register and evaluate your scores, they will be listed here.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var result in Model)
            {
                <div class="col-lg-6 col-md-12">
                    <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 20px; transition: transform 0.3s; position: relative; overflow: hidden;">
                        <div style="position: absolute; top: 0; left: 0; width: 6px; height: 100%; background: @(result.IsPublished ? (result.LetterGrade == "F" ? "#ef4444" : "#10b981") : "#f59e0b");"></div>
                        
                        <div class="card-body p-2">
                            <!-- Course / Teacher Info -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">Academic Evaluation</h5>
                                    <p class="text-muted small mb-0"><i class="fas fa-chalkboard-teacher me-1"></i> Evaluated by: <strong>@result.Teacher?.Name</strong></p>
                                </div>
                                
                                <div>
                                    @if (result.IsPublished)
                                    {
                                        <span class="badge bg-success px-3 py-1.5" style="border-radius: 8px;">
                                            <i class="fas fa-check-circle me-1"></i> Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1.5" style="border-radius: 8px;">
                                            <i class="fas fa-clock me-1"></i> Pending Review
                                        </span>
                                    }
                                </div>
                            </div>

                            <hr class="my-3 opacity-10">

                            @if (result.IsPublished)
                            {
                                <!-- Published Marks & Grade Card -->
                                <div class="row g-3">
                                    <!-- Big Score Overview -->
                                    <div class="col-md-5 d-flex flex-column justify-content-center align-items-center bg-light rounded-4 py-4 px-3 text-center">
                                        <span class="text-muted small text-uppercase fw-semibold mb-2">Final Letter Grade</span>
                                        <h1 class="display-3 fw-extrabold text-primary mb-1">@result.LetterGrade</h1>
                                        <span class="badge bg-dark px-3 py-1.5 fs-7 mb-2">GPA: @result.GradePoint.ToString("0.00")</span>
                                        <small class="text-muted fw-bold">Remarks: @result.Remarks</small>
                                    </div>

                                    <!-- Marks breakdown details -->
                                    <div class="col-md-7 d-flex flex-column justify-content-center ps-md-4">
                                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-list-ol text-muted me-2"></i>Assessment Score Breakdown</h6>
                                        
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Attendance</span>
                                            <span class="fw-semibold text-dark">@result.Attendance <small class="text-muted">/ 10</small></span>
                                        </div>
                                        <div class="progress mb-3" style="height: 6px;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @(result.Attendance * 10)%" aria-valuenow="@result.Attendance" aria-valuemin="0" aria-valuemax="10"></div>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Class Test (CT)</span>
                                            <span class="fw-semibold text-dark">@result.ClassTest <small class="text-muted">/ 20</small></span>
                                        </div>
                                        <div class="progress mb-3" style="height: 6px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(result.ClassTest * 5)%" aria-valuenow="@result.ClassTest" aria-valuemin="0" aria-valuemax="20"></div>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Mid-Term</span>
                                            <span class="fw-semibold text-dark">@result.MidTerm <small class="text-muted">/ 30</small></span>
                                        </div>
                                        <div class="progress mb-3" style="height: 6px;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @(result.MidTerm * 3.33)%" aria-valuenow="@result.MidTerm" aria-valuemin="0" aria-valuemax="30"></div>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Final Exam</span>
                                            <span class="fw-semibold text-dark">@result.FinalExam <small class="text-muted">/ 40</small></span>
                                        </div>
                                        <div class="progress mb-3" style="height: 6px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @(result.FinalExam * 2.5)%" aria-valuenow="@result.FinalExam" aria-valuemin="0" aria-valuemax="40"></div>
                                        </div>

                                        <hr class="my-2 opacity-5">

                                        <div class="d-flex justify-content-between fw-bold text-dark mt-1">
                                            <span>Cumulative Total Marks</span>
                                            <span class="text-primary">@result.Total <small class="text-muted fw-normal">/ 100</small></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Pending Review View (Draft State) -->
                                <div class="p-4 bg-warning bg-opacity-5 rounded-4 border border-warning border-opacity-10 text-center">
                                    <div class="mx-auto mb-3" style="width: 56px; height: 56px; background: rgba(245, 158, 11, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #f59e0b;">
                                        <i class="fas fa-lock fa-lg"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">Result Under Review</h6>
                                    <p class="text-muted small mb-0 px-2">Your marks for this evaluation are currently in draft status. The teacher is finalizing the marks and has not published them yet. Please check back later.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
