@model IEnumerable<finalSE.Models.StudentMark>
@{
    ViewData["Title"] = "My Academic Results";
    var student = ViewBag.Student as finalSE.Models.StudentModel;
    double cgpa = Model.Any() ? Model.Average(m => m.GradePoint) : 0;
    int published = Model.Count();
}

<div class="container-fluid py-4 animate-up">
    <!-- Hero Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 text-white rounded-5 shadow-lg position-relative overflow-hidden"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 24px;">
                <!-- decorative circles -->
                <div style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.04);"></div>
                <div style="position:absolute;bottom:-30px;right:100px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.03);"></div>

                <div class="position-relative">
                    <span class="badge bg-white bg-opacity-20 text-white px-3 py-2 fs-7 fw-semibold mb-3" style="border-radius:8px;">
                        <i class="fas fa-graduation-cap me-1"></i> Student Academic Record
                    </span>
                    <h1 class="fw-bold display-5 mb-2">Academic Transcript</h1>
                    <p class="fs-6 text-white-50 mb-4">
                        <strong>@student?.Name</strong> &bull; Department of @(student?.Department?.DepartmentName ?? "N/A") &bull; @student?.Email
                    </p>

                    <!-- Quick stats -->
                    <div class="row g-3 mt-1" style="max-width:600px;">
                        <div class="col-4">
                            <div class="p-3 rounded-4" style="background:rgba(255,255,255,.08);">
                                <div class="text-white-50 small mb-1">Subjects</div>
                                <div class="fw-bold fs-4 text-white">@published</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 rounded-4" style="background:rgba(255,255,255,.08);">
                                <div class="text-white-50 small mb-1">CGPA</div>
                                <div class="fw-bold fs-4 text-white">@cgpa.ToString("0.00")</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 rounded-4" style="background:rgba(255,255,255,.08);">
                                <div class="text-white-50 small mb-1">Status</div>
                                <div class="fw-bold fs-6 text-white">
                                    @if (cgpa >= 2.0) { <span>✅ Passing</span> } else { <span>⚠️ Review</span> }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Grid -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center" style="border-radius:20px;">
            <div class="py-5">
                <div class="mx-auto mb-4" style="width:100px;height:100px;background:rgba(79,70,229,.05);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-clipboard-list fa-4x text-muted opacity-50"></i>
                </div>
                <h3 class="fw-bold mb-2">No Published Results Yet</h3>
                <p class="text-muted mb-0">No results have been published for your subjects yet.</p>
                <p class="small text-muted">Once your teachers publish marks for a subject, they will appear here.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Summary Table -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold m-0"><i class="fas fa-table text-primary me-2"></i>All Subjects — Grade Summary</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase fw-bold text-muted border-bottom" style="font-size:.78rem;">
                            <tr>
                                <th class="ps-4">Subject</th>
                                <th class="text-center">Attendance<br><span class="fw-normal text-muted" style="font-size:.72rem;">/10</span></th>
                                <th class="text-center">Class Test<br><span class="fw-normal text-muted" style="font-size:.72rem;">/20</span></th>
                                <th class="text-center">Mid-Term<br><span class="fw-normal text-muted" style="font-size:.72rem;">/30</span></th>
                                <th class="text-center">Final<br><span class="fw-normal text-muted" style="font-size:.72rem;">/40</span></th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Grade</th>
                                <th class="text-center pe-4">GPA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                string badgeColor = r.LetterGrade == "F" ? "bg-danger text-white"
                                    : r.LetterGrade.StartsWith("A") ? "bg-success"
                                    : r.LetterGrade.StartsWith("B") ? "bg-primary"
                                    : r.LetterGrade.StartsWith("C") ? "bg-info text-dark"
                                    : "bg-warning text-dark";
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark" style="font-size:.9rem;">@r.Subject?.SubjectName</div>
                                        <div class="text-muted" style="font-size:.78rem;">
                                            @r.Subject?.SubjectCode &bull;
                                            <i class="fas fa-chalkboard-teacher me-1"></i>@r.Teacher?.Name
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold">@r.Attendance</td>
                                    <td class="text-center fw-semibold">@r.ClassTest</td>
                                    <td class="text-center fw-semibold">@r.MidTerm</td>
                                    <td class="text-center fw-semibold">@r.FinalExam</td>
                                    <td class="text-center fw-bold text-primary">@r.Total</td>
                                    <td class="text-center">
                                        <span class="badge @badgeColor px-3 py-1.5" style="font-size:.85rem;border-radius:8px;">@r.LetterGrade</span>
                                    </td>
                                    <td class="text-center pe-4 fw-bold @(r.GradePoint >= 2.0 ? "text-success" : "text-danger")">
                                        @r.GradePoint.ToString("0.00")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light fw-bold border-top">
                            <tr>
                                <td class="ps-4 text-dark">Cumulative GPA (CGPA)</td>
                                <td colspan="6"></td>
                                <td class="text-center pe-4 fs-5 @(cgpa >= 2.0 ? "text-success" : "text-danger")">
                                    @cgpa.ToString("0.00")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Detailed Cards per Subject -->
        <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-layer-group text-primary me-2"></i>Detailed Subject Breakdown</h5>
        <div class="row g-4">
            @foreach (var result in Model)
            {
                string leftBar = result.LetterGrade == "F" ? "#ef4444"
                    : result.LetterGrade.StartsWith("A") ? "#10b981"
                    : result.LetterGrade.StartsWith("B") ? "#4f46e5"
                    : result.LetterGrade.StartsWith("C") ? "#06b6d4"
                    : "#f59e0b";

                <div class="col-lg-6 col-md-12">
                    <div class="card border-0 shadow-sm h-100 p-4"
                         style="border-radius:20px;position:relative;overflow:hidden;transition:transform .3s;">
                        <!-- colour stripe -->
                        <div style="position:absolute;top:0;left:0;width:6px;height:100%;background:@leftBar;"></div>

                        <div class="card-body p-2">
                            <!-- Subject title row -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">@result.Subject?.SubjectName</h5>
                                    <p class="text-muted small mb-0">
                                        <span class="badge bg-secondary me-1" style="font-size:.72rem;">@result.Subject?.SubjectCode</span>
                                        <i class="fas fa-chalkboard-teacher me-1"></i> @result.Teacher?.Name
                                    </p>
                                </div>
                                <span class="badge bg-success px-3 py-1.5" style="border-radius:8px;font-size:.8rem;">
                                    <i class="fas fa-check-circle me-1"></i> Published
                                </span>
                            </div>

                            <hr class="my-3 opacity-10">

                            <!-- Score layout -->
                            <div class="row g-3">
                                <!-- Big grade box -->
                                <div class="col-md-5 d-flex flex-column justify-content-center align-items-center bg-light rounded-4 py-4 px-3 text-center">
                                    <span class="text-muted small text-uppercase fw-semibold mb-2">Final Letter Grade</span>
                                    <h1 class="display-3 fw-bold mb-1" style="color:@leftBar;">@result.LetterGrade</h1>
                                    <span class="badge bg-dark px-3 py-1.5 fs-7 mb-2">GPA: @result.GradePoint.ToString("0.00")</span>
                                    <small class="text-muted fw-bold">@result.Remarks</small>
                                </div>

                                <!-- Progress breakdown -->
                                <div class="col-md-7 d-flex flex-column justify-content-center ps-md-4">
                                    <h6 class="fw-bold text-dark mb-3"><i class="fas fa-list-ol text-muted me-2"></i>Score Breakdown</h6>

                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Attendance</span>
                                        <span class="fw-semibold text-dark small">@result.Attendance <small class="text-muted">/ 10</small></span>
                                    </div>
                                    <div class="progress mb-3" style="height:6px;">
                                        <div class="progress-bar bg-info" style="width:@(result.Attendance * 10)%"></div>
                                    </div>

                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Class Test (CT)</span>
                                        <span class="fw-semibold text-dark small">@result.ClassTest <small class="text-muted">/ 20</small></span>
                                    </div>
                                    <div class="progress mb-3" style="height:6px;">
                                        <div class="progress-bar bg-primary" style="width:@(result.ClassTest * 5)%"></div>
                                    </div>

                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Mid-Term</span>
                                        <span class="fw-semibold text-dark small">@result.MidTerm <small class="text-muted">/ 30</small></span>
                                    </div>
                                    <div class="progress mb-3" style="height:6px;">
                                        <div class="progress-bar bg-warning" style="width:@(result.MidTerm * 3.33)%"></div>
                                    </div>

                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Final Exam</span>
                                        <span class="fw-semibold text-dark small">@result.FinalExam <small class="text-muted">/ 40</small></span>
                                    </div>
                                    <div class="progress mb-3" style="height:6px;">
                                        <div class="progress-bar bg-success" style="width:@(result.FinalExam * 2.5)%"></div>
                                    </div>

                                    <hr class="my-2 opacity-5">
                                    <div class="d-flex justify-content-between fw-bold text-dark">
                                        <span>Total</span>
                                        <span style="color:@leftBar;">@result.Total <small class="text-muted fw-normal">/ 100</small></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card:hover { transform: translateY(-2px); }
    .fs-7 { font-size: .8rem; }
</style>
