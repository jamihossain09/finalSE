@model IEnumerable<finalSE.Models.Tutorial>

@{
    ViewData["Title"] = "Study Materials & Tutorials";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary me-3" style="border-radius: 8px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h2 class="fw-bold text-dark m-0"><i class="fas fa-file-pdf text-info me-2"></i>Study Materials & Slides</h2>
                <p class="text-muted m-0">Access PDF tutorials, lecture presentations, slides, and learning links</p>
            </div>
        </div>
    </div>

    <!-- Search bar -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
        <div class="card-body p-3">
            <form method="get" class="row g-2">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by topic title, description, or teacher's name..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100" style="border-radius: 8px;">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Materials Grid -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="far fa-folder-open fa-3x mb-3"></i>
                <p class="fs-5">No study materials found.</p>
            </div>
        }
        else
        {
            @foreach (var tutorial in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 16px; overflow: hidden; background: #fff;">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-light text-info py-2 px-3 fw-bold" style="border-radius: 8px;">
                                    <i class="far fa-calendar-alt me-1"></i> @tutorial.UploadedAt.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                            
                            <h4 class="card-title fw-bold text-dark mb-2">@tutorial.Title</h4>
                            <p class="card-text text-muted small flex-grow-1">@tutorial.Description</p>
                            
                            <div class="mb-3">
                                <span class="small fw-semibold text-dark"><i class="fas fa-chalkboard-teacher me-1 text-primary"></i> By: @(tutorial.Teacher?.Name ?? "Teacher")</span>
                            </div>
                            
                            <div class="mt-auto pt-3 border-top">
                                <div class="d-flex flex-column gap-2">
                                    @if (!string.IsNullOrEmpty(tutorial.FilePath))
                                    {
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="small text-muted">
                                                @if (tutorial.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <i class="far fa-file-pdf text-danger me-1"></i> <span>PDF Document</span>
                                                }
                                                else
                                                {
                                                    <i class="far fa-file-powerpoint text-warning me-1"></i> <span>PowerPoint Slide</span>
                                                }
                                            </span>
                                            <div class="d-flex gap-2">
                                                <a href="@tutorial.FilePath" target="_blank" class="btn btn-outline-secondary btn-sm px-3" style="border-radius: 8px;">View</a>
                                                <a href="@tutorial.FilePath" download class="btn btn-secondary btn-sm px-3" style="border-radius: 8px;">Download</a>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(tutorial.VideoLink))
                                    {
                                        <div class="d-flex justify-content-between align-items-center @(!string.IsNullOrEmpty(tutorial.FilePath) ? "mt-2 pt-2 border-top border-dashed" : "")">
                                            <span class="small text-muted"><i class="fas fa-video text-success me-1"></i> Video Class</span>
                                            <a href="@tutorial.VideoLink" target="_blank" class="btn btn-primary btn-sm px-3" style="border-radius: 8px;">
                                                <i class="fas fa-play me-1"></i> Watch Video
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .border-top.border-dashed {
        border-top-style: dashed !important;
    }
</style>
