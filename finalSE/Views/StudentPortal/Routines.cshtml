@model IEnumerable<Routine>

@{
    ViewData["Title"] = "Class & Exam Routines";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3" style="border-radius: 8px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="fas fa-calendar-alt text-primary me-2"></i>Class & Exam Routines</h2>
            <p class="text-muted m-0">View latest routines published by the administration</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Type</th>
                            <th>Uploaded At</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="far fa-calendar-times fa-3x mb-3"></i>
                                    <p class="mb-0">No routines are uploaded by admin yet.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@item.Title</td>
                                    <td>
                                        <span class="badge @(item.Type == "Class" ? "bg-primary-soft text-primary" : "bg-warning-soft text-warning") px-3 py-2 fw-semibold" style="border-radius: 8px;">
                                            @item.Type
                                        </span>
                                    </td>
                                    <td class="text-muted">@item.UploadedAt.ToString("g")</td>
                                    <td class="text-end pe-4">
                                        <a href="@item.FilePath" target="_blank" class="btn btn-outline-primary btn-sm px-3" style="border-radius: 8px;">
                                            <i class="far fa-file-pdf me-1"></i> View / Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-soft {
        background-color: rgba(13, 110, 253, 0.1);
    }
    .bg-warning-soft {
        background-color: rgba(255, 193, 7, 0.15);
    }
</style>
