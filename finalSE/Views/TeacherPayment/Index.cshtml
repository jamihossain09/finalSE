@{
    ViewData["Title"] = "Teacher Salary Payment";
    var teachers = ViewBag.TeachersList as List<finalSE.Models.Teacher>;
    var payments = ViewBag.Payments as List<finalSE.Models.TeacherPayment>;
}

<div class="container-fluid py-4 animate-up">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 text-white rounded-5 shadow-lg position-relative overflow-hidden"
                 style="background: linear-gradient(135deg, #e11d48 0%, #be123c 50%, #9f1239 100%); border-radius: 24px;">
                <div class="position-relative z-index-1">
                    <span class="badge bg-white bg-opacity-20 text-white px-3 py-2 fs-7 fw-semibold mb-3" style="border-radius: 8px;">
                        <i class="fas fa-wallet me-1"></i> Payment Management
                    </span>
                    <h1 class="fw-bold display-5 mb-2">Teacher Salary Payment</h1>
                    <p class="fs-5 text-white-50 mb-0">Process salary payments via bKash Payment Gateway</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Payment Form -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div style="width: 48px; height: 48px; background: rgba(225, 29, 72, 0.1); color: #e11d48; border-radius: 14px; display: flex; align-items: center; justify-content: center;" class="fs-4">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold m-0">Process New Payment</h5>
                            <small class="text-muted">Select teacher and set payment amount</small>
                        </div>
                    </div>

                    <form asp-action="InitiatePayment" asp-controller="TeacherPayment" method="post" id="paymentForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-chalkboard-teacher me-1 text-muted"></i> Select Teacher
                            </label>
                            <select name="teacherId" id="teacherSelect" class="form-select form-select-lg" style="border-radius: 12px;" required>
                                <option value="">-- Choose Teacher --</option>
                                @if (teachers != null)
                                {
                                    @foreach (var t in teachers)
                                    {
                                        <option value="@t.Id" data-department="@t.Department?.DepartmentName" data-email="@t.Email" data-phone="@t.Phone">
                                            @t.Name (@t.Department?.DepartmentName)
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Teacher Info Card (shown on selection) -->
                        <div id="teacherInfoCard" class="mb-3 p-3 border rounded-4 bg-light" style="display: none;">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 42px; height: 42px; background: var(--sidebar-bg, #4f46e5); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white;">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                                <div>
                                    <div class="fw-bold" id="teacherInfoName">-</div>
                                    <small class="text-muted" id="teacherInfoDetails">-</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt me-1 text-muted"></i> Payment Month
                            </label>
                            <select name="month" class="form-select form-select-lg" style="border-radius: 12px;" required>
                                <option value="">-- Select Month --</option>
                                @{
                                    var months = new[] { "January", "February", "March", "April", "May", "June",
                                                        "July", "August", "September", "October", "November", "December" };
                                    var currentYear = DateTime.Now.Year;
                                    var currentMonth = DateTime.Now.Month;
                                    for (int i = 0; i < 12; i++)
                                    {
                                        var monthName = $"{months[i]} {currentYear}";
                                        <option value="@monthName" selected="@(i + 1 == currentMonth)">@monthName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-bangladeshi-taka-sign me-1 text-muted"></i> Amount (BDT)
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text" style="border-radius: 12px 0 0 12px; font-weight: 700;">৳</span>
                                <input type="number" name="amount" id="amountInput" class="form-control form-control-lg"
                                       placeholder="Enter amount" min="1" step="0.01" required
                                       style="border-radius: 0 12px 12px 0;" />
                            </div>
                        </div>

                        <button type="submit" id="bkashPayBtn" class="btn btn-lg w-100 text-white fw-bold"
                                style="background: linear-gradient(135deg, #e2136e, #d1145c); border: none; border-radius: 14px; padding: 14px; font-size: 1.1rem; transition: all 0.3s;">
                            <i class="fas fa-mobile-alt me-2"></i> Pay via bKash
                        </button>

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                <i class="fas fa-shield-alt me-1"></i> Secured by bKash Payment Gateway (Sandbox Mode)
                            </small>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Recent Payments Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 14px; display: flex; align-items: center; justify-content: center;" class="fs-4">
                                <i class="fas fa-history"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold m-0">Recent Payments</h5>
                                <small class="text-muted">Latest 20 transactions</small>
                            </div>
                        </div>
                        <a asp-action="PaymentHistory" class="btn btn-outline-primary" style="border-radius: 10px;">
                            <i class="fas fa-list me-1"></i> View All
                        </a>
                    </div>

                    @if (payments != null && payments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="paymentsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="border-radius: 10px 0 0 0;">Teacher</th>
                                        <th>Month</th>
                                        <th>Amount</th>
                                        <th>TrxID</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th style="border-radius: 0 10px 0 0;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in payments.Take(20))
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div style="width: 36px; height: 36px; background: rgba(79, 70, 229, 0.1); color: #4f46e5; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
                                                        <i class="fas fa-user-tie"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">@p.Teacher?.Name</div>
                                                        <small class="text-muted">@p.Teacher?.Department?.DepartmentName</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-light text-dark">@p.Month</span></td>
                                            <td class="fw-bold">৳@p.Amount.ToString("N2")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(p.TransactionID))
                                                {
                                                    <code class="text-primary">@p.TransactionID</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@p.PaymentDate.ToString("dd MMM yyyy")</small>
                                                <br />
                                                <small class="text-muted opacity-75">@p.PaymentDate.ToString("hh:mm tt")</small>
                                            </td>
                                            <td>
                                                @if (p.Status == "Paid")
                                                {
                                                    <span class="badge bg-success px-3 py-2" style="border-radius: 8px;"><i class="fas fa-check-circle me-1"></i> Paid</span>
                                                }
                                                else if (p.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-2" style="border-radius: 8px;"><i class="fas fa-clock me-1"></i> Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger px-3 py-2" style="border-radius: 8px;"><i class="fas fa-times-circle me-1"></i> Failed</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="DeletePayment" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this payment record?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@p.PaymentID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-receipt fa-4x text-muted mb-3 opacity-25"></i>
                            <h6 class="text-muted fw-bold">No Payments Yet</h6>
                            <p class="text-muted small">Start by processing a salary payment for a teacher.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #bkashPayBtn:hover {
        background: linear-gradient(135deg, #d1145c, #b91048) !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(226, 19, 110, 0.35);
    }
    #bkashPayBtn:active {
        transform: translateY(0);
    }
    .form-select:focus, .form-control:focus {
        box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.15);
        border-color: #e11d48;
    }
    .table th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        font-weight: 700;
        border-bottom: 2px solid #e2e8f0;
    }
    .table td {
        vertical-align: middle;
        padding: 0.85rem 0.75rem;
    }
</style>

@section Scripts {
    <script>
        // Show teacher info card on selection
        document.getElementById('teacherSelect').addEventListener('change', function () {
            var selectedOption = this.options[this.selectedIndex];
            var card = document.getElementById('teacherInfoCard');

            if (this.value) {
                var dept = selectedOption.getAttribute('data-department');
                var email = selectedOption.getAttribute('data-email');
                var phone = selectedOption.getAttribute('data-phone');

                document.getElementById('teacherInfoName').textContent = selectedOption.text;
                document.getElementById('teacherInfoDetails').textContent = email + ' • ' + phone;
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });

        // Prevent double-submit
        document.getElementById('paymentForm').addEventListener('submit', function () {
            var btn = document.getElementById('bkashPayBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Redirecting to bKash...';
        });
    </script>
}
